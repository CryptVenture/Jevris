{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jevris:contract:quality-measurement:1.0",
  "title": "QualityMeasurement",
  "description": "A measured quality ratio with its interval, method and sample size (§18.3).",
  "type": "object",
  "properties": {
    "metric": {
      "const": "verified-success-ratio"
    },
    "arm": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {
        "anyOf": [
          {
            "pattern": "(?:^|[^A-Za-z0-9])sk-ant-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])sk-(?:proj-)?[A-Za-z0-9_-]{16,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])gh[pousr]_[A-Za-z0-9]{20,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])github_pat_"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])xox[abprs]-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])AIza[0-9A-Za-z_-]{30,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])glpat-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])npm_[A-Za-z0-9]{30,}"
          },
          {
            "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9_-])(?=[A-Za-z0-9_-]*[a-z])(?=[A-Za-z0-9_-]*[A-Z])(?=[A-Za-z0-9_-]*[0-9])[A-Za-z0-9_-]{32,}"
          }
        ]
      }
    },
    "baseline": {
      "type": "string",
      "enum": [
        "rules-only",
        "native",
        "static"
      ]
    },
    "point": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "lower": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "upper": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "interval": {
      "type": "string",
      "enum": [
        "wilson",
        "clopper-pearson",
        "bootstrap",
        "beta-posterior"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 0.999
    },
    "n": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "holdoutId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {
        "anyOf": [
          {
            "pattern": "(?:^|[^A-Za-z0-9])sk-ant-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])sk-(?:proj-)?[A-Za-z0-9_-]{16,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])gh[pousr]_[A-Za-z0-9]{20,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])github_pat_"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])xox[abprs]-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])AIza[0-9A-Za-z_-]{30,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])glpat-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])npm_[A-Za-z0-9]{30,}"
          },
          {
            "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9_-])(?=[A-Za-z0-9_-]*[a-z])(?=[A-Za-z0-9_-]*[A-Z])(?=[A-Za-z0-9_-]*[0-9])[A-Za-z0-9_-]{32,}"
          }
        ]
      }
    }
  },
  "required": [
    "metric",
    "arm",
    "baseline",
    "point",
    "lower",
    "upper",
    "interval",
    "confidence",
    "n",
    "holdoutId"
  ],
  "additionalProperties": false
}
