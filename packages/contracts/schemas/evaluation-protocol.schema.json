{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jevris:contract:evaluation-protocol:1.0",
  "title": "EvaluationProtocol",
  "description": "The frozen evaluation protocol: baselines, split policy, annotation rule, holdout id and margin (§18.2).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "evaluation-protocol"
    },
    "frozenBaseline": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "rules-only",
          "native",
          "static"
        ]
      },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true
    },
    "splitPolicy": {
      "const": "repository-and-time"
    },
    "annotationInstruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "not": {
        "anyOf": [
          {
            "pattern": "(?:^|[^A-Za-z0-9])sk-ant-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])sk-(?:proj-)?[A-Za-z0-9_-]{16,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])gh[pousr]_[A-Za-z0-9]{20,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])github_pat_"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])xox[abprs]-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])AIza[0-9A-Za-z_-]{30,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])glpat-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])npm_[A-Za-z0-9]{30,}"
          },
          {
            "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9_-])(?=[A-Za-z0-9_-]*[a-z])(?=[A-Za-z0-9_-]*[A-Z])(?=[A-Za-z0-9_-]*[0-9])[A-Za-z0-9_-]{32,}"
          },
          {
            "pattern": "[A-Za-z][A-Za-z0-9+.-]*://"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])www\\."
          }
        ]
      }
    },
    "sourceCorpus": {
      "type": "boolean"
    },
    "trainer": {
      "type": "boolean"
    },
    "holdoutId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {
        "anyOf": [
          {
            "pattern": "(?:^|[^A-Za-z0-9])sk-ant-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])sk-(?:proj-)?[A-Za-z0-9_-]{16,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])gh[pousr]_[A-Za-z0-9]{20,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])github_pat_"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])xox[abprs]-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])AIza[0-9A-Za-z_-]{30,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])glpat-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])npm_[A-Za-z0-9]{30,}"
          },
          {
            "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9_-])(?=[A-Za-z0-9_-]*[a-z])(?=[A-Za-z0-9_-]*[A-Z])(?=[A-Za-z0-9_-]*[0-9])[A-Za-z0-9_-]{32,}"
          }
        ]
      }
    },
    "labelledCorpus": {
      "type": "boolean"
    },
    "qualityGate": {
      "type": "string",
      "enum": [
        "not-passed",
        "passed"
      ]
    },
    "nonInferiorityMargin": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.5
    },
    "preRegistrationHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "frozenBaseline",
    "splitPolicy",
    "annotationInstruction",
    "sourceCorpus",
    "trainer",
    "holdoutId",
    "labelledCorpus"
  ],
  "additionalProperties": false
}
