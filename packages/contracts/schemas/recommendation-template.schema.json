{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jevris:contract:recommendation-template:1.0",
  "title": "RecommendationTemplate",
  "description": "Trusted recommendation text with typed slots. Model output is never interpolated (§6.1).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {
        "anyOf": [
          {
            "pattern": "(?:^|[^A-Za-z0-9])sk-ant-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])sk-(?:proj-)?[A-Za-z0-9_-]{16,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])gh[pousr]_[A-Za-z0-9]{20,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])github_pat_"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])xox[abprs]-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])AIza[0-9A-Za-z_-]{30,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])glpat-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])npm_[A-Za-z0-9]{30,}"
          },
          {
            "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9_-])(?=[A-Za-z0-9_-]*[a-z])(?=[A-Za-z0-9_-]*[A-Z])(?=[A-Za-z0-9_-]*[0-9])[A-Za-z0-9_-]{32,}"
          }
        ]
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?:[^{}]|\\{evidenceCount\\}|\\{evidenceIds\\})+$",
      "not": {
        "anyOf": [
          {
            "pattern": "(?:^|[^A-Za-z0-9])sk-ant-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])sk-(?:proj-)?[A-Za-z0-9_-]{16,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])gh[pousr]_[A-Za-z0-9]{20,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])github_pat_"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])xox[abprs]-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])AIza[0-9A-Za-z_-]{30,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])glpat-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])npm_[A-Za-z0-9]{30,}"
          },
          {
            "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9_-])(?=[A-Za-z0-9_-]*[a-z])(?=[A-Za-z0-9_-]*[A-Z])(?=[A-Za-z0-9_-]*[0-9])[A-Za-z0-9_-]{32,}"
          },
          {
            "pattern": "[A-Za-z][A-Za-z0-9+.-]*://"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])www\\."
          }
        ]
      }
    }
  },
  "required": [
    "id",
    "version",
    "text"
  ],
  "additionalProperties": false
}
