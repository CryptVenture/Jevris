{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jevris:contract:decision-spec:1.0",
  "title": "DecisionSpec",
  "description": "A versioned decision: question hash, evidence requirements, deadline, fallback, calibration (§6.2).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {
        "anyOf": [
          {
            "pattern": "(?:^|[^A-Za-z0-9])sk-ant-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])sk-(?:proj-)?[A-Za-z0-9_-]{16,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])gh[pousr]_[A-Za-z0-9]{20,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])github_pat_"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])xox[abprs]-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])AIza[0-9A-Za-z_-]{30,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])glpat-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])npm_[A-Za-z0-9]{30,}"
          },
          {
            "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9_-])(?=[A-Za-z0-9_-]*[a-z])(?=[A-Za-z0-9_-]*[A-Z])(?=[A-Za-z0-9_-]*[0-9])[A-Za-z0-9_-]{32,}"
          }
        ]
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {
        "anyOf": [
          {
            "pattern": "(?:^|[^A-Za-z0-9])sk-ant-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])sk-(?:proj-)?[A-Za-z0-9_-]{16,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])gh[pousr]_[A-Za-z0-9]{20,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])github_pat_"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])xox[abprs]-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])AIza[0-9A-Za-z_-]{30,}"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])glpat-"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9])npm_[A-Za-z0-9]{30,}"
          },
          {
            "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY"
          },
          {
            "pattern": "(?:^|[^A-Za-z0-9_-])(?=[A-Za-z0-9_-]*[a-z])(?=[A-Za-z0-9_-]*[A-Z])(?=[A-Za-z0-9_-]*[0-9])[A-Za-z0-9_-]{32,}"
          }
        ]
      }
    },
    "questionHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidenceRequirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
        "not": {
          "anyOf": [
            {
              "pattern": "(?:^|[^A-Za-z0-9])sk-ant-"
            },
            {
              "pattern": "(?:^|[^A-Za-z0-9])sk-(?:proj-)?[A-Za-z0-9_-]{16,}"
            },
            {
              "pattern": "(?:^|[^A-Za-z0-9])gh[pousr]_[A-Za-z0-9]{20,}"
            },
            {
              "pattern": "(?:^|[^A-Za-z0-9])github_pat_"
            },
            {
              "pattern": "(?:^|[^A-Za-z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}"
            },
            {
              "pattern": "(?:^|[^A-Za-z0-9])xox[abprs]-"
            },
            {
              "pattern": "(?:^|[^A-Za-z0-9])AIza[0-9A-Za-z_-]{30,}"
            },
            {
              "pattern": "(?:^|[^A-Za-z0-9])glpat-"
            },
            {
              "pattern": "(?:^|[^A-Za-z0-9])npm_[A-Za-z0-9]{30,}"
            },
            {
              "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY"
            },
            {
              "pattern": "(?:^|[^A-Za-z0-9_-])(?=[A-Za-z0-9_-]*[a-z])(?=[A-Za-z0-9_-]*[A-Z])(?=[A-Za-z0-9_-]*[0-9])[A-Za-z0-9_-]{32,}"
            }
          ]
        }
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "deadlineMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000
    },
    "fallback": {
      "type": "string",
      "enum": [
        "rules-only",
        "advice",
        "abstain"
      ]
    },
    "calibrationId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "not": {
            "anyOf": [
              {
                "pattern": "(?:^|[^A-Za-z0-9])sk-ant-"
              },
              {
                "pattern": "(?:^|[^A-Za-z0-9])sk-(?:proj-)?[A-Za-z0-9_-]{16,}"
              },
              {
                "pattern": "(?:^|[^A-Za-z0-9])gh[pousr]_[A-Za-z0-9]{20,}"
              },
              {
                "pattern": "(?:^|[^A-Za-z0-9])github_pat_"
              },
              {
                "pattern": "(?:^|[^A-Za-z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}"
              },
              {
                "pattern": "(?:^|[^A-Za-z0-9])xox[abprs]-"
              },
              {
                "pattern": "(?:^|[^A-Za-z0-9])AIza[0-9A-Za-z_-]{30,}"
              },
              {
                "pattern": "(?:^|[^A-Za-z0-9])glpat-"
              },
              {
                "pattern": "(?:^|[^A-Za-z0-9])npm_[A-Za-z0-9]{30,}"
              },
              {
                "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY"
              },
              {
                "pattern": "(?:^|[^A-Za-z0-9_-])(?=[A-Za-z0-9_-]*[a-z])(?=[A-Za-z0-9_-]*[A-Z])(?=[A-Za-z0-9_-]*[0-9])[A-Za-z0-9_-]{32,}"
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "version",
    "questionHash",
    "evidenceRequirements",
    "deadlineMs",
    "fallback",
    "calibrationId"
  ],
  "additionalProperties": false
}
