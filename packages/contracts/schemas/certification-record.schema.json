          "reasonCode": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
                "not": {
                  "anyOf": [
                    {
                      "pattern": "(?:^|[^A-Za-z0-9])sk-ant-"
