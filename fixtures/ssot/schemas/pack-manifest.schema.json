{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jevris pack-manifest: proposed v1 handoff subset",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^jevris\\.[a-z][a-z0-9.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "maturity": {
      "enum": [
        "experimental",
        "canary",
        "stable"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "requiresCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 256,
      "uniqueItems": true
    },
    "fallbackCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 256,
      "uniqueItems": true
    },
    "decisionSpecs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 256,
      "uniqueItems": true
    },
    "actions": {
      "type": "array",
      "items": {
        "enum": [
          "advise",
          "route-worker",
          "request-checkpoint",
          "select-evidence",
          "request-verification",
          "cancel-owned-worker",
          "abstain"
        ]
      },
      "maxItems": 256,
      "uniqueItems": true
    },
    "dataScopes": {
      "type": "array",
      "items": {
        "enum": [
          "task-metadata",
          "approved-source-spans",
          "approved-tool-output",
          "verification-receipts",
          "policy-metadata"
        ]
      },
      "maxItems": 256,
      "uniqueItems": true
    },
    "defaultMode": {
      "enum": [
        "off",
        "observe",
        "advise",
        "bounded-auto"
      ]
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 256,
      "uniqueItems": true
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 256,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "maturity",
    "description",
    "requiresCapabilities",
    "fallbackCapabilities",
    "decisionSpecs",
    "actions",
    "dataScopes",
    "defaultMode",
    "conflicts",
    "fixtures"
  ],
  "additionalProperties": false
}
