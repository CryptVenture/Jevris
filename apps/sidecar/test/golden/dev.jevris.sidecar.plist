<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.jevris.sidecar</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/opt/jevris/dist/sidecar.mjs</string>
    <string>--supervised</string>
    <string>--home</string>
    <string>/home/dev/My Jevris &quot;home&quot; $x %y</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/dev/.jevris/logs/service.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dev/.jevris/logs/service.log</string>
</dict>
</plist>
